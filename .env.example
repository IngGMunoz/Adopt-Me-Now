# Copia este archivo como .env y cambia los valores.
# docker compose y la app leen estas variables automáticamente.

# Clave para firmar las cookies de sesión (genera una con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambia-esta-clave

# Código que se pide en /registro-administrador para crear cuentas de administrador
ADMIN_REGISTRATION_CODE=cambia-este-codigo

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=cambia-esta-contraseña
DB_NAME=adoptme

# Alternativa: una URL completa tiene prioridad sobre DB_* (útil para despliegue)
# DATABASE_URL=mysql+pymysql://usuario:contraseña@host:3306/adoptme

# Servidor
PORT=5100
FLASK_DEBUG=false
# Pon true cuando la app se sirva por HTTPS
SESSION_COOKIE_SECURE=false
